# Application
LOG_LEVEL="info"                # fatal | error | warn | info | debug | trace | silent

# Database: a separate database per environment (docs/03-standards/environment.md)
DATABASE_URL="postgresql://user:password@localhost:5432/app_dev"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/app_test"   # never the dev database (ADR 0044)

# Authentication (docs/04-stack/better-auth.md)
BETTER_AUTH_SECRET=""           # at least 32 characters: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"   # the public origin

# Dev seed: `pnpm db:seed` (ADR 0042). Read only by scripts/seed.ts, never by the app.
# The seed stops before writing unless SEED_ALLOW is exactly "true", and always when NODE_ENV is "production".
SEED_ALLOW="false"
SEED_SUPERADMIN_NAME="Superadmin"
SEED_SUPERADMIN_USERNAME="superadmin"
SEED_SUPERADMIN_EMAIL="superadmin@simlog.test"
SEED_SUPERADMIN_PASSWORD=""     # at least 8 characters; the sample accounts use it too
